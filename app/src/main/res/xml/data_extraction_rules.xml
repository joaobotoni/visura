<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Tokens de sessão e o id do dispositivo não saem do aparelho (backup na nuvem nem transferência). -->
    <cloud-backup>
        <exclude domain="sharedpref" path="visura_sessao.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="visura_sessao.xml"/>
    </device-transfer>
</data-extraction-rules>